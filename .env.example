# Neon Postgres via the Vercel Marketplace. This is the variable the app
# actually reads (src/lib/db.ts mirrors it into POSTGRES_URL for
# @vercel/postgres). Locally: `vercel env pull .env.local`.
STORAGE_POSTGRES_URL=
STORAGE_POSTGRES_URL_NON_POOLING=

# Secret for /api/setup endpoint (create table)
SETUP_SECRET=

# WebRTC signaling relay (used by P2P demos)
NEXT_PUBLIC_RELAY_URL=wss://swarm-engine-production-5b98.up.railway.app
