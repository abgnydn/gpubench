# Data lives in Cloudflare D1 (binding `DB` in wrangler.jsonc) — no
# connection string needed. Plain `next dev` runs without a database; the
# data APIs respond with empty payloads locally.

# Secret for /api/setup endpoint (create table)
SETUP_SECRET=

# WebRTC signaling relay (used by P2P demos)
NEXT_PUBLIC_RELAY_URL=wss://swarm-engine-production-5b98.up.railway.app
